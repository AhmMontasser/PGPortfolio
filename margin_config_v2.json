{
  "input": {
    "quote": "USDT",
    "coin_number": 10,
    "trade_period": 1800,
    "window_size": 31,
    "feature_number": 4,
    "volume_average_days": 30,
    "min_history_days": 45,
    "train_start_date": "2019/01/01",
    "start_date": "2020/01/01",
    "end_date": "2026/07/01"
  },
  "network": {
    "conv_filters": 8,
    "dense_filters": 20
  },
  "training": {
    "steps": 30000,
    "rolling_steps": 2000,
    "rolling_lookback_days": 120,
    "batch_size": 109,
    "buffer_biased": 5e-5,
    "learning_rate": 0.00028
  },
  "trading": {
    "trading_consumption": 0.001
  },
  "margin": {
    "max_leverage": 1.5,
    "max_coin_weight": 0.25,
    "short_borrow_apr": 0.10,
    "usdt_borrow_apr": 0.10,
    "gross_penalty": 0.0,
    "boundary_penalty": 2e-5
  },
  "overlay": {
    "vol_target": 0.60,
    "vol_window": 336,
    "dd_soft": 0.05,
    "dd_hard": 0.14,
    "dd_floor": 0.10
  },
  "data": {
    "database": "./database/dynamic_data.db",
    "download_workers": 16
  },
  "output": {
    "directory": "./dynamic_results/margin_v2"
  }
}
